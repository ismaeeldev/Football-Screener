    "test:ui": "playwright test tests/ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:migrate:test": "cross-env PRISMA_ENV=test tsx scripts/db-migrate.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "token:create": "tsx scripts/create-token.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:dev": "cross-env SEED_FIXTURES=1 tsx prisma/seed.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "run:daily": "tsx scripts/run-daily.ts",
    "contrast": "node scripts/contrast.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "make-og": "node scripts/make-og.mjs",
    "prod:smoke": "tsx scripts/prod-smoke.ts"
  },
  "dependencies": {
